# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection for the server.
# Local Supabase (npx supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted Supabase: Project settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL and publishable key (Project settings → API keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The organisation this deployment serves (created by supabase/seed.sql).
ORGANISATION_SLUG=pilot

# Secret for the Supabase "Send SMS" auth hook. Generate in the Supabase
# dashboard (Authentication → Hooks → Send SMS) or for local use any
# value of the form v1,whsec_<base64>.
SEND_SMS_HOOK_SECRET=v1,whsec_bG9jYWwtZGV2ZWxvcG1lbnQtc2VjcmV0LW9ubHk=

# Text messages: "fake" prints messages to the server console (development only);
# "arkesel" sends real messages.
SMS_PROVIDER=fake
ARKESEL_API_KEY=
# Sender ID approved by Arkesel, at most 11 characters.
ARKESEL_SENDER_ID=

# Only for the database tests: a Postgres server where the user can create databases.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
